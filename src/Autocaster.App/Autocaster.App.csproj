    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <AssemblyName>WarframeAutocaster</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="NokkoIcons.png" />
    <ProjectReference Include="../Autocaster.Core/Autocaster.Core.csproj" />
    <ProjectReference Include="../Autocaster.Windows/Autocaster.Windows.csproj" />
    <ProjectReference Include="../Autocaster.Infrastructure/Autocaster.Infrastructure.csproj" />
  </ItemGroup>
</Project>
