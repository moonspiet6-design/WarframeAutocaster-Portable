<ComboBox x:Class="Autocaster.App.ProfilePicker"
          x:ClassModifier="internal"
          xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          MinWidth="136" MaxWidth="180" Margin="0,0,8,5"
          FocusVisualStyle="{x:Null}">
    <ComboBox.Resources>
        <DataTemplate x:Key="ProfileRow">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="×" FontSize="15" FontWeight="SemiBold"
                        Width="24" Height="23" MinWidth="0" MinHeight="0"
                        Margin="4,0,0,0" Padding="0" Focusable="False" Click="RemoveClicked"
                        AutomationProperties.Name="Delete">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Setter Property="Foreground" Value="{DynamicResource EditorMuted}" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="BorderBrush" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Value="True"
                                    Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=ComboBoxItem}}">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource EditorAccentText}" />
                                    <Setter Property="Background" Value="{DynamicResource EditorSelected}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource EditorAccentLine}" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                <TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
            </DockPanel>
        </DataTemplate>
        <DataTemplate x:Key="AddRow">
            <Button Content="{Binding}" Focusable="False" FocusVisualStyle="{x:Null}" Click="AddClicked"
                    HorizontalContentAlignment="Left" MinHeight="24" Padding="0"
                    Background="Transparent" BorderThickness="0" />
        </DataTemplate>
    </ComboBox.Resources>
</ComboBox>
