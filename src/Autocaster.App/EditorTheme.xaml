<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="ToolbarAction" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource EditorSurface}" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorLine}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Face" CornerRadius="5" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                        <ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".83" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Face" Property="Opacity" Value=".66" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource EditorFocus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Face" Property="Opacity" Value=".48" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>
    <Style x:Key="MacroSettingsMap" TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style x:Key="MacroSettingsSection" TargetType="Expander">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border BorderBrush="{DynamicResource EditorLine}" BorderThickness="0,1,0,0">
                        <StackPanel>
                            <ToggleButton Content="{TemplateBinding Header}"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          AutomationProperties.Name="{TemplateBinding Header}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="SectionFace" Background="Transparent" BorderBrush="Transparent"
                                                BorderThickness="1" Padding="9,5" SnapsToDevicePixels="True">
                                            <DockPanel>
                                                <Path x:Name="SectionArrow" Data="M 2,1 L 6,5 L 2,9" Width="8" Margin="0,0,5,0"
                                                      StrokeThickness="1.4" Stroke="{DynamicResource EditorMuted}" VerticalAlignment="Center" />
                                                <ContentPresenter TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource EditorText}"
                                                                  VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="SectionArrow" Property="Data" Value="M 0,3 L 4,7 L 8,3" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="SectionFace" Property="Background" Value="{DynamicResource EditorSurface}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused" Value="True">
                                                <Setter TargetName="SectionFace" Property="BorderBrush" Value="{DynamicResource EditorFocus}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="SectionBody" ContentSource="Content" />
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="SectionBody" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="ActiveToolbarAction" TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
        <Setter Property="Background" Value="{DynamicResource EditorSelected}" />
        <Setter Property="Foreground" Value="{DynamicResource EditorAccentText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorAccentLine}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="PrimaryToolbarAction" TargetType="Button" BasedOn="{StaticResource ToolbarAction}">
        <Setter Property="Background" Value="{DynamicResource EditorAccent}" />
        <Setter Property="Foreground" Value="{DynamicResource EditorAccentInk}" />
        <Setter Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="EditorCheck" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="MinHeight" Value="23" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <DockPanel Background="Transparent">
                        <Border x:Name="Box" Width="16" Height="16" Margin="0,0,6,0" CornerRadius="3"
                                BorderThickness="1" BorderBrush="{DynamicResource EditorMuted}"
                                Background="{DynamicResource EditorBackground}" VerticalAlignment="Center">
                            <Path x:Name="Tick" Data="M 0,4 L 3,7 L 9,0" Visibility="Collapsed"
                                  StrokeThickness="1.7" Stroke="{DynamicResource EditorAccentInk}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ContentPresenter RecognizesAccessKey="True" VerticalAlignment="Center" />
                    </DockPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource EditorAccent}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                            <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource EditorFocus}" />
                            <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="EditorSettingsTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Face" Padding="10,6" Margin="0,0,4,2" BorderThickness="0,0,0,2"
                            BorderBrush="Transparent" Background="Transparent" CornerRadius="5,5,0,0">
                        <ContentPresenter x:Name="TabTitle" ContentSource="Header" RecognizesAccessKey="True"
                                          TextElement.Foreground="{DynamicResource EditorMuted}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource EditorSurface}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="TabTitle" Property="TextElement.Foreground" Value="{DynamicResource EditorAccentText}" />
                            <Setter TargetName="Face" Property="Background" Value="{DynamicResource EditorSelected}" />
                            <Setter TargetName="Face" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="StepRow" TargetType="ListBoxItem">
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="Foreground" Value="{DynamicResource EditorText}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="GroupBand" Background="Transparent" Margin="16,0,16,0" SnapsToDevicePixels="True">
                    <Border x:Name="RowFrame" Background="{DynamicResource EditorSurface}" BorderThickness="1"
                            BorderBrush="Transparent" CornerRadius="5" SnapsToDevicePixels="True">
                    <StackPanel>
                        <Border x:Name="RowHeader" Background="Transparent" CornerRadius="4" Padding="8,4" MinHeight="31">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="NumberColumn" Width="44" />
                                    <ColumnDefinition x:Name="IconColumn" Width="0" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="20" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="Number" Text="{Binding Number}" Foreground="{DynamicResource EditorMuted}"
                                           FontSize="12" VerticalAlignment="Center" />
                                <Image x:Name="StepIcon" Grid.Column="1" Source="{Binding Icon}" Width="20" Height="20"
                                       Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" />
                                <TextBlock x:Name="Title" Grid.Column="2" Text="{Binding Kind}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Summary}" Foreground="{DynamicResource EditorMuted}"
                                           FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="260" Margin="12,0,6,0" VerticalAlignment="Center" />
                                <Path x:Name="Chevron" Grid.Column="4" Data="M 0,0 L 4,4 L 8,0" Stroke="{DynamicResource EditorMuted}"
                                      StrokeThickness="1.4" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Border x:Name="InlinePanel" Visibility="Collapsed" BorderBrush="{DynamicResource EditorLine}"
                                BorderThickness="0,1,0,0" Padding="10,6,10,8">
                            <ContentPresenter Content="{Binding InlineEditor}" />
                        </Border>
                    </StackPanel>
                    </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding HasIcon}" Value="True">
                            <Setter TargetName="NumberColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="Number" Property="MinWidth" Value="16" />
                            <Setter TargetName="Number" Property="Margin" Value="0,0,4,0" />
                            <Setter TargetName="IconColumn" Property="Width" Value="24" />
                            <Setter TargetName="StepIcon" Property="Visibility" Value="Visible" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Number}" Value="Auto">
                            <Setter TargetName="RowFrame" Property="Margin" Value="10,0,0,0" />
                            <Setter TargetName="RowHeader" Property="MinHeight" Value="27" />
                            <Setter TargetName="RowHeader" Property="Padding" Value="8,2" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding InGroup}" Value="True">
                            <Setter Property="Margin" Value="0" />
                            <Setter TargetName="GroupBand" Property="Background" Value="{Binding GroupColors.Block}" />
                            <Setter TargetName="GroupBand" Property="BorderBrush" Value="{Binding GroupColors.Edge}" />
                            <Setter TargetName="GroupBand" Property="BorderThickness" Value="1,0,1,0" />
                            <Setter TargetName="GroupBand" Property="Padding" Value="4,0,4,4" />
                            <Setter TargetName="RowFrame" Property="Background" Value="{Binding GroupColors.Row}" />
                        </DataTrigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowHeader" Property="Background" Value="{DynamicResource EditorHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowHeader" Property="Background" Value="{DynamicResource EditorSelected}" />
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource EditorAccentLine}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource EditorAccentText}" />
                        </Trigger>
                        <DataTrigger Binding="{Binding HasInlineEditor}" Value="True">
                            <Setter TargetName="InlinePanel" Property="Visibility" Value="Visible" />
                            <Setter TargetName="RowFrame" Property="Background" Value="{DynamicResource EditorChrome}" />
                            <Setter TargetName="RowHeader" Property="CornerRadius" Value="4,4,0,0" />
                            <Setter TargetName="Chevron" Property="Data" Value="M 0,4 L 4,0 L 8,4" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Running}" Value="True">
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource EditorAccent}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource EditorAccentText}" />
                            <Setter TargetName="Number" Property="Text" Value="▶" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource EditorFocus}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InGroup}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowHeader" Property="Background" Value="{Binding GroupColors.Hover}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InGroup}" Value="True" />
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowFrame" Property="Background" Value="{Binding GroupColors.Selected}" />
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{Binding GroupColors.Line}" />
                            <Setter TargetName="RowHeader" Property="Background" Value="Transparent" />
                            <Setter TargetName="Number" Property="Foreground" Value="{Binding GroupColors.Text}" />
                            <Setter TargetName="InlinePanel" Property="BorderBrush" Value="{Binding GroupColors.Edge}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InGroup}" Value="True" />
                                <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{Binding GroupColors.Text}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding InGroup}" Value="True" />
                                <Condition Binding="{Binding Running}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{Binding GroupColors.Text}" />
                            <Setter TargetName="Number" Property="Foreground" Value="{Binding GroupColors.Text}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding GroupEnd}" Value="True">
                            <Setter Property="Margin" Value="0,0,0,4" />
                            <Setter TargetName="GroupBand" Property="CornerRadius" Value="0,0,6,6" />
                            <Setter TargetName="GroupBand" Property="BorderThickness" Value="1,0,1,1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                            <Setter TargetName="GroupBand" Property="CornerRadius" Value="6,6,0,0" />
                            <Setter TargetName="GroupBand" Property="BorderThickness" Value="1,1,1,0" />
                            <Setter TargetName="GroupBand" Property="Padding" Value="4,3,4,3" />
                            <Setter TargetName="RowFrame" Property="Background" Value="Transparent" />
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="RowHeader" Property="Background" Value="Transparent" />
                            <Setter TargetName="RowHeader" Property="MinHeight" Value="22" />
                            <Setter TargetName="RowHeader" Property="Padding" Value="6,1" />
                            <Setter TargetName="Title" Property="Foreground" Value="{Binding GroupColors.Text}" />
                            <Setter TargetName="NumberColumn" Property="Width" Value="16" />
                            <Setter TargetName="Chevron" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Chevron" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Chevron" Property="Width" Value="11" />
                            <Setter TargetName="Chevron" Property="Height" Value="11" />
                            <Setter TargetName="Chevron" Property="Data" Value="M 1.5,3.5 L 5.5,7.5 L 9.5,3.5" />
                            <Setter TargetName="Chevron" Property="StrokeStartLineCap" Value="Round" />
                            <Setter TargetName="Chevron" Property="StrokeEndLineCap" Value="Round" />
                            <Setter TargetName="Chevron" Property="StrokeLineJoin" Value="Round" />
                            <Setter TargetName="Chevron" Property="Stroke" Value="{Binding GroupColors.Text}" />
                            <Setter TargetName="InlinePanel" Property="BorderBrush" Value="{Binding GroupColors.Edge}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Folded}" Value="True">
                            <Setter TargetName="Chevron" Property="Data" Value="M 3.5,1.5 L 7.5,5.5 L 3.5,9.5" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGroupHeader}" Value="True" />
                                <Condition Binding="{Binding GroupEnd}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="GroupBand" Property="CornerRadius" Value="6" />
                            <Setter TargetName="GroupBand" Property="BorderThickness" Value="1" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsGroupHeader}" Value="True" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowHeader" Property="Background" Value="{Binding GroupColors.Hover}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Moving}" Value="True">
                            <Setter Property="Panel.ZIndex" Value="1" />
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource EditorMuted}" />
                            <Setter TargetName="RowHeader" Property="Background" Value="Transparent" />
                            <Setter TargetName="Number" Property="Foreground" Value="{DynamicResource EditorMuted}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Moving}" Value="True" />
                                <Condition Binding="{Binding InGroup}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="RowFrame" Property="BorderBrush" Value="{Binding GroupColors.Line}" />
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
